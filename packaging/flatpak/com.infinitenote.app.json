{
  "id": "com.infinitenote.app",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "infinitenote",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--filesystem=home"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig"
  ],
  "modules": [
    {
      "name": "infinitenote",
      "buildsystem": "simple",
      "sources": [
        {
          "type": "file",
          "path": "infinitenote-wrapper.sh"
        },
        {
          "type": "file",
          "path": "com.infinitenote.app.desktop"
        },
        {
          "type": "file",
          "path": "com.infinitenote.app.metainfo.xml"
        },
        {
          "type": "file",
          "path": "icons/com.infinitenote.app.png"
        },
        {
          "type": "file",
          "path": "icons/com.infinitenote.app.svg"
        },
        {
          "type": "extra-data",
          "filename": "InfiniteNote.AppImage",
          "url": "https://github.com/shalosi00/infinitenote/releases/download/v1.6.0/InfiniteNote_1.6.0_amd64.AppImage",
          "sha256": "",
          "size": 0
        }
      ],
      "build-commands": [
        "install -Dm755 infinitenote-wrapper.sh ${FLATPAK_DEST}/bin/infinitenote",
        "install -Dm644 com.infinitenote.app.desktop ${FLATPAK_DEST}/share/applications/com.infinitenote.app.desktop",
        "install -Dm644 com.infinitenote.app.metainfo.xml ${FLATPAK_DEST}/share/metainfo/com.infinitenote.app.metainfo.xml",
        "install -Dm644 icons/com.infinitenote.app.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/com.infinitenote.app.png",
        "install -Dm644 icons/com.infinitenote.app.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/com.infinitenote.app.svg"
      ]
    }
  ]
}
